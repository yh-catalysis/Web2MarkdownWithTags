{
    "name": "web2markdown-with-tags",
    "version": "1.0.0",
    "private": true,
    "packageManager": "pnpm@11.21.0",
    "scripts": {
        "dev": "wrangler dev",
        "deploy": "wrangler deploy",
        "tail": "wrangler tail",
        "test": "vitest run",
        "test:watch": "vitest",
        "lint": "tsc --noEmit"
    },
    "devDependencies": {
        "@cloudflare/workers-types": "5.20260924.1",
        "typescript": "7.0.2",
        "vitest": "5.0.1",
        "wrangler": "4.138.0"
    },
    "dependencies": {
        "@cfworker/json-schema": "^4.1.1",
        "@cloudflare/puppeteer": "^1.0.0",
        "@modelcontextprotocol/sdk": "1.26.0",
        "agents": "^0.5.1",
        "hono": "^4.13.9",
        "zod": "^3.25.0"
    },
    "cloudflare": {
        "bindings": {
            "AUTH_TOKEN": {
                "description": "MCP / REST API の Bearer トークン。32文字以上のランダムな文字列を入れ、同じ値を MCP クライアント（Claude Desktop / Claude Code など）にも設定する。生成例: `openssl rand -hex 32`"
            },
            "ALLOW_IMAGE_CONVERSION": {
                "description": "画像のMarkdown変換（Workers AI の Neurons を消費）を許可するなら `true`。既定は `false`。"
            }
        }
    }
}